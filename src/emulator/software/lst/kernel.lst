1712   08C4             ;------------------------------------------------------------------------------------------------------;
1713   08C4             ; create new directory
1714   08C4             ;------------------------------------------------------------------------------------------------------;
1715   08C4             ; search list for null name entry. add new directory to list
1716   08C4             fs_mkdir:
1717   08C4 FD 4E         mov si, d
1718   08C6 FD 4F 5B 1F   mov di, user_data
1719   08CA 38 00 02      mov c, 512
1720   08CD 04            load                        ; load data from user-space
1721   08CE 26 22 00      mov b, fst_lba_start + 2    ; start at 2 because lba  0 is root (this would also cause issues                 
1722   08D1                                           ; when checking for null name, since root has a null name)
1723   08D1 38 00 00      mov c, 0                    ; upper lba = 0
1724   08D4             fs_mkdir_l1:  
1725   08D4 22 01         mov ah, $01                  ; 1 sector
1726   08D6 3B 5B 33      mov d, transient_area
1727   08D9 07 BE 06      call ide_read_sect          ; read sector
1728   08DC BD 00         cmp byte[d], 0              ; check for null
1729   08DE C6 E7 08      je fs_mkdir_found_null
1730   08E1 55 02 00      add b, fst_sectors_per_dir  ; skip directory
1731   08E4 0A D4 08      jmp fs_mkdir_l1
1732   08E7             fs_mkdir_found_null:
1733   08E7             ;create header file by grabbing dir name from parameter
1734   08E7 D8            push b                      ; save new directory's lba
1735   08E8 38 40 00      mov c, 64
1736   08EB FD 4D 5B 1F   mov si, user_data
1737   08EF FD 4F 5B 33   mov di, transient_area
1738   08F3 FD F5         rep movsb                   ; copy dirname from user_data to transient_area
1739   08F5 14 5E 19      mov a, [current_dir_id]
1740   08F8 42 9B 33      mov [transient_area + 64], a    ; store parent directory lba
1741   08FB 19 00         mov al, 0
1742   08FD FD 4F 5B 35   mov di, transient_area + 512
1743   0901 38 00 02      mov c, 512
1744   0904 FD F7         rep stosb                       ; clean buffer
1745   0906 38 00 00      mov c, 0                        ; reset lba(c) to 0
1746   0909             ; write directory entry sectors
1747   0909 3B 5B 33      mov d, transient_area
1748   090C 22 02         mov ah, $02                     ; disk write, 2 sectors
1749   090E 07 E4 06      call ide_write_sect             ; write sector
1750   0911             ; now we need to add the new directory to the list, inside the current directory
1751   0911 14 5E 19      mov a, [current_dir_id]
1752   0914 53 01 00      add a, 1
1753   0917 27            mov b, a                        ; metadata sector
1754   0918 38 00 00      mov c, 0
1755   091B FD 79         mov g, b                        ; save lba
1756   091D 3B 5B 33      mov d, transient_area
1757   0920 22 01         mov ah, $01                  ; 1 sector
1758   0922 07 BE 06      call ide_read_sect              ; read metadata sector
