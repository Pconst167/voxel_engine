0605   01CF D8            push b
0606   01D0 26 08 00      mov b, 8
0607   01D3 07 63 03      call wait_xs
0608   01D6 F2 C8 FF 53   mov byte [_fdc_stat_cmd], %01010011   ; step in
0609   01DA E5            pop b
0610   01DB 6C 01         add bl, 1
