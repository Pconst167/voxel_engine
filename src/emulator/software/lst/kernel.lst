1351   0687             ; ide services syscall
1352   0687             ; al = option
1353   0687             ; 0 = ide reset, 1 = ide sleep, 2 = read sector, 3 = write sector
1354   0687             ; ide read/write sector
1355   0687             ; 512 bytes
1356   0687             ; user buffer pointer in d
1357   0687             ; ah = number of sectors
1358   0687             ; cb = lba bytes 3..0
1359   0687             ; ------------------------------------------------------------------------------------------------------------------;
