1766   0934 FD 50         mov di, d
1767   0936 07 77 12      call _strcpy                    ; copy directory name
1768   0939 58 18 00      add d, 24                       ; goto attributes
1769   093C 19 0B         mov al, %00001011               ; directory, no execute, write, read
1770   093E 3E            mov [d], al      
1771   093F 79            inc d
1772   0940 E5            pop b
1773   0941 D8            push b                          ; push lba back
1774   0942 FD 43         mov [d], b                      ; save lba
1775   0944             ; set file creation date  
1776   0944 58 04 00      add d, 4
1777   0947 19 04         mov al, 4
1778   0949 05 01         syscall sys_rtc
1779   094B 1A            mov al, ah
1780   094C 3E            mov [d], al                     ; set day
1781   094D 79            inc d
1782   094E 19 05         mov al, 5
1783   0950 05 01         syscall sys_rtc
1784   0952 1A            mov al, ah
1785   0953 3E            mov [d], al                     ; set month
1786   0954 79            inc d
1787   0955 19 06         mov al, 6
1788   0957 05 01         syscall sys_rtc
1789   0959 1A            mov al, ah
1790   095A 3E            mov [d], al                     ; set year
1791   095B             ; write sector into disk for new directory entry
1792   095B FD 27         mov b, g
1793   095D 38 00 00      mov c, 0
1794   0960 3B 5B 33      mov d, transient_area
1795   0963 22 01         mov ah, $01                     ; disk write, 1 sector
1796   0965 07 E4 06      call ide_write_sect             ; write sector
1797   0968             
1798   0968             ; after adding the new directory's information to its parent directory's list
1799   0968             ; we need to now enter the new directory, and to it add two new directories!
1800   0968             ; which directories do we need to add ? '..' and '.' are the directories needed.
1801   0968             ; importantly, note that these two new directories are only entries in the list
1802   0968             ; and do not have actual physical entries in the disk as real directories.
1803   0968             ; i.e. they only exist as list entries in the new directory created so that
1804   0968             ; the new directory can reference its parent and itself.
1805   0968             ; we need to add both '..' and '.'
1806   0968             ; this first section is for '..' and on the section below we do the same for '.'
