0613   01E2 06            sysret
0614   01E3             
0615   01E3             ; di : destination in user space
0616   01E3             ; a  : returns number of read bytes
0617   01E3             syscall_fdc_read_track:
0618   01E3 07 7B 02      call fdc_wait_not_busy
0619   01E6 E3            push di
0620   01E7 FD 4F 5B 33   mov di, transient_area
0621   01EB F2 C8 FF E8   mov byte [_fdc_stat_cmd], %11101000
0622   01EF 07 5C 03      call fdc_wait_64us
0623   01F2             fdc_read_track_l0: ; for each byte, we need to wait for drq to be high
0624   01F2 1D C8 FF      mov al, [_fdc_stat_cmd]      ; 
0625   01F5 93 01         test al, $01                ; check busy bit
0626   01F7 C6 06 02      jz fdc_read_track_end
0627   01FA 93 02         test al, $02                ; check drq bit
0628   01FC C6 F2 01      jz fdc_read_track_l0
0629   01FF 1D CB FF      mov al, [_fdc_data]     ; 
0630   0202 F7            stosb
0631   0203 0A F2 01      jmp fdc_read_track_l0
0632   0206             ;we need to check if writing to data reg causes a spurious read. so lets check inside the writing loop, how many times we actually write the bytes
0633   0206             ;say the 40 byte loop. if we find that we only write ~20 times, then this indcates this problem.
0634   0206             ;because for every write, if it also reads, then that clears drq, so we need to wait for next drq.
0635   0206             fdc_read_track_end:
0636   0206 50            mov a, di
0637   0207 5F 5B 33      sub a, transient_area
0638   020A F0            pop di
0639   020B FD 4D 5B 33   mov si, transient_area
0640   020F 39            mov c, a  ; copy track over to user space
0641   0210 03            store
0642   0211 06            sysret
0643   0212             
0644   0212             ; sector in bl
0645   0212             ; track in bh
0646   0212             ; di = user space destination
0647   0212             syscall_fdc_read_sect:
0648   0212 07 7B 02      call fdc_wait_not_busy
0649   0215 E3            push di
0650   0216 FD 3D CA FF   mov [_fdc_sector], bl
0651   021A 30            mov bl, bh
0652   021B FD 3D C9 FF   mov [_fdc_track], bl
0653   021F F2 C8 FF 88   mov byte [_fdc_stat_cmd], %10001000
0654   0223 07 5C 03      call fdc_wait_64us
0655   0226 FD 4F 5B 33   mov di, transient_area
0656   022A             fdc_read_sect_l0: ; for each byte, we need to wait for drq to be high
0657   022A 1D C8 FF      mov al, [_fdc_stat_cmd]      ; read lost data flag 10+3+5+8+5+8
0658   022D 93 01         test al, $01                ; check drq bit
0659   022F C6 3E 02      jz fdc_read_sect_end
0660   0232 93 02         test al, $02                ; check drq bit
0661   0234 C6 2A 02      jz fdc_read_sect_l0
0662   0237 1D CB FF      mov al, [_fdc_data]     ; 
0663   023A F7            stosb
