1600   07F8             ; for a directory we have the header first, followed by metadata
1601   07F8             ; header 1 sector (512 bytes)
1602   07F8             ; metadata 1 sector (512 bytes)
1603   07F8             ; header entries:
1604   07F8             ; filename (64)
1605   07F8             ; parent dir lba (2) -  to be used for faster backwards navigation...
1606   07F8             ;
1607   07F8             ; metadata entries:
1608   07F8             ; filename (24)
1609   07F8             ; attributes (1)  |_|_|file_type(3bits)|x|w|r| types: file, directory, character device
1610   07F8             ; lba (2)
1611   07F8             ; size (2)
1612   07F8             ; day (1)
1613   07F8             ; month (1)
1614   07F8             ; year (1)
1615   07F8             ; packet size = 32 bytes
