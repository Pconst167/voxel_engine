0980   03C2             ; reboot system
0981   03C2             syscall_reboot:
0982   03C2 FD D7 FF FF   push word $ffff 
0983   03C6 FD DB 00      push byte %00000000             ; dma_ack = 0, interrupts disabled, mode = supervisor, paging = off, halt=0, display_reg_load=0, dir=0
0984   03C9 FD D7 90 01   push word bios_reset_vector     ; and then push reset vector of the shell to the stack
0985   03CD 06            sysret
