0987   03CE             ;------------------------------------------------------------------------------------------------------;;
0988   03CE             ; switch to another process
0989   03CE             ; inputs:
0990   03CE             ; al = new process number
0991   03CE             ;------------------------------------------------------------------------------------------------------;;
0992   03CE             syscall_resume_proc:
0993   03CE FD 78         mov g, a                            ; save the process number
0994   03D0 4B            pusha                               ; save all registers into kernel stack
0995   03D1 22 00         mov ah, 0
0996   03D3 1D 55 19      mov al, [active_proc_index]
0997   03D6 FD 99         shl a              ; x2
0998   03D8 B7 8D 11      mov a, [proc_table_convert + a]     ; get process state start index
0999   03DB 4F            mov di, a
1000   03DC 48            mov a, sp
1001   03DD 77            inc a
1002   03DE 4D            mov si, a
1003   03DF 38 14 00      mov c, 20
1004   03E2 FD F5         rep movsb                           ; save process state!
1005   03E4             ; restore kernel stack position to point before interrupt arrived
1006   03E4 51 14 00      add sp, 20
1007   03E7             ; now load the new process number!
1008   03E7 FD 12         mov a, g                            ; retrieve the process number argument that was saved in the beginning
1009   03E9 3D 55 19      mov [active_proc_index], al         ; set new active proc
1010   03EC             ; calculate lut entry for next process
1011   03EC 22 00         mov ah, 0
1012   03EE FD 99         shl a                               ; x2
1013   03F0 B7 8D 11      mov a, [proc_table_convert + a]     ; get process state start index  
1014   03F3 4D            mov si, a                           ; source is proc state block
1015   03F4 48            mov a, sp
1016   03F5 5F 13 00      sub a, 19
1017   03F8 4F            mov di, a                           ; destination is kernel stack
1018   03F9             ; restore sp
1019   03F9 7D            dec a
1020   03FA 47            mov sp, a
1021   03FB 38 14 00      mov c, 20
1022   03FE FD F5         rep movsb
1023   0400             ; set vm process
1024   0400 1D 55 19      mov al, [active_proc_index]
1025   0403 01            setptb
1026   0404 4C            popa
1027   0405 06            sysret
