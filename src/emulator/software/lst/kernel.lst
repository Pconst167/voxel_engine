0061   0000             _bios_post_ctrl   .equ $ffb3         ; bios post display control register, 80h = as output
0062   0000             _pio_a            .equ $ffb0    
0063   0000             _pio_b            .equ $ffb1
0064   0000             _pio_c            .equ $ffb2
0065   0000             _pio_control      .equ $ffb3         ; pio control port
0066   0000             
0067   0000             _fdc_config       .equ $ffc0         ; 0 = select_0, 1 = select_1, 2 = side_select, 3 = dden, 4 = in_use_or_head_load, 5 = wd1770_rst
0068   0000             _fdc_status_0     .equ $ffc1         ; 0 = drq, 1 = ready
0069   0000             _fdc_stat_cmd     .equ $ffc8         ; status / command register
0070   0000             _fdc_track        .equ $ffc9         ; track register
0071   0000             _fdc_sector       .equ $ffca         ; sector register
0072   0000             _fdc_data         .equ $ffcb         ; data register
0073   0000             
