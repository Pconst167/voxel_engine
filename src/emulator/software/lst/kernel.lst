1203   056C             ; ------------------------------------------------------------------------------------------------------------------;
1204   056C             ; real-time clock services syscall
1205   056C             ; rtc i/o bank = ffa0 to ffaf
1206   056C             ; ffa0 to ffa7 is scratch ram
1207   056C             ; control register at $ffa8 [ w | r | s | cal4..cal0 ]
1208   056C             ; al = 0..6 -> get
1209   056C             ; al = 7..d -> set
1210   056C             ; ------------------------------------------------------------------------------------------------------------------;
1211   056C             syscall_rtc:
1212   056C DB            push al
1213   056D DA            push d
1214   056E B9 06         cmp al, 6
1215   0570 D1 85 05      jgu syscall_rtc_set
1216   0573             syscall_rtc_get:
1217   0573 6A A9         add al, $a9             ; generate rtc address to get to address a9 of clock
1218   0575 22 FF         mov ah, $ff    
1219   0577 3C            mov d, a                ; get to ffa9 + offset
1220   0578 F2 A8 FF 40   mov byte[$ffa8], $40    ; set r bit to 1
1221   057C 1E            mov al, [d]             ; get data
1222   057D F2 A8 FF 00   mov byte[$ffa8], 0      ; reset r bit
1223   0581 23            mov ah, al
1224   0582 E7            pop d
1225   0583 E8            pop al
1226   0584 06            sysret
1227   0585             syscall_rtc_set:
1228   0585 DD            push bl
1229   0586 99            mov bl, ah              ; set data aside
1230   0587 6A A2         add al, $a2             ; generate rtc address to get to address a9 of clock
1231   0589 22 FF         mov ah, $ff    
1232   058B 3C            mov d, a                ; get to ffa9 + offset
1233   058C 1B            mov al, bl              ; get data back
1234   058D F2 A8 FF 80   mov byte[$ffa8], $80    ; set w bit to 1
1235   0591 3E            mov [d], al             ; set data
1236   0592 F2 A8 FF 00   mov byte[$ffa8], 0      ; reset write bit
1237   0596 EA            pop bl
1238   0597 E7            pop d
1239   0598 E8            pop al
1240   0599 06            sysret
