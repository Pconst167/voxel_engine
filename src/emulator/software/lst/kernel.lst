1117   0492 FD 4F 5B 31   mov di, scrap_sector    ; destination in kernel space
1118   0496 38 00 02      mov c, 512
1119   0499 04            load                    ; transfer data to kernel space!
1120   049A 3B 5B 31      mov d, scrap_sector     ; dump pointer in d
1121   049D 38 00 00      mov c, 0
