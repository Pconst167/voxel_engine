0563   0173 07 5C 03      call fdc_wait_64us
0564   0176             fdc_formatdisk_drq_128:
0565   0176 1D C8 FF      mov al, [_fdc_stat_cmd]     ; 10
0566   0179 93 01         test al, $01                ; 4
0567   017B C6 8A 01      jz fdc_formatdisk_end_128           ; 8
0568   017E 93 02         test al, $02                ; 4
