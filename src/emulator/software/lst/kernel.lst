1669   086A             fs_chmod:
1670   086A DD            push bl
1671   086B FD 4E         mov si, d
1672   086D FD 4F 5B 1F   mov di, user_data
1673   0871 38 80 00      mov c, 128
1674   0874 04            load                        ; load filename from user-space
1675   0875 14 5E 19      mov a, [current_dir_id]
1676   0878 77            inc a                       ; metadata sector
1677   0879 27            mov b, a
1678   087A 38 00 00      mov c, 0                    ; upper lba = 0
1679   087D 22 01         mov ah, $01                  ; 1 sector
1680   087F 3B 5B 33      mov d, transient_area
1681   0882 07 BE 06      call ide_read_sect          ; read directory
1682   0885 FD 10         cla
