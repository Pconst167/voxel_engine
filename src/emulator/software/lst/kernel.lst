0334   003C             ; irqs' code block
0335   003C             ; ------------------------------------------------------------------------------------------------------------------;
0336   003C             ; 5.25" floppy drive controller irq
0337   003C             int_0_fdc:
0338   003C 3B 39 1B      mov d, s_fdc_irq
0339   003F 07 1F 14      call _puts
0340   0042 06            sysret
0341   0043             int_1:
0342   0043 06            sysret
0343   0044             int_2:
0344   0044 06            sysret
0345   0045             int_3:
0346   0045 06            sysret
0347   0046             int_4:
0348   0046 06            sysret
0349   0047             
0350   0047             ; ------------------------------------------------------------------------------------------------------------------;
0351   0047             ; uart1 interrupt
0352   0047             ; ------------------------------------------------------------------------------------------------------------------;
0353   0047             int_5_uart1:
0354   0047 D7            push a
0355   0048 DA            push d
0356   0049 E1            pushf
0357   004A 1D 88 FF      mov al, [_uart1_data]       ; get character
0358   004D B9 03         cmp al, $03                 ; ctrl-c
0359   004F C6 A0 00      je ctrlc
0360   0052 B9 1A         cmp al, $1a                 ; ctrl-z
0361   0054 C6 A6 00      je ctrlz
0362   0057               ;mov [[d]], al              ; TODO: implement this double indirection instruction
0363   0057 3B 5A 19      mov d, fifo_in
0364   005A FD 2A         mov d, [d]
0365   005C 3E            mov [d], al                 ; add to fifo
0366   005D 13            mov a, d
0367   005E 77            inc a
0368   005F AF 5B 31      cmp a, fifo + _fifo_size     ; check if pointer reached the end of the fifo
0369   0062 C7 68 00      jne int_5_continue
0370   0065 10 5B 21      mov a, fifo  
0371   0068             int_5_continue:  
0372   0068 42 5A 19      mov [fifo_in], a            ; update fifo pointer
0373   006B 1A            mov al, ah
0374   006C 3D B0 FF      mov [_til311_display], al
0375   006F EE            popf
0376   0070 E7            pop d
0377   0071 E4            pop a  
0378   0072 06            sysret
0379   0073             
0380   0073             ; ------------------------------------------------------------------------------------------------------------------;
0381   0073             ; timer irq
0382   0073             ; ------------------------------------------------------------------------------------------------------------------;
0383   0073             int_6_timer:  
0384   0073 06            sysret
0385   0074             
0386   0074             ; ------------------------------------------------------------------------------------------------------------------;
0387   0074             ; uart0 interrupt
0388   0074             ; ------------------------------------------------------------------------------------------------------------------;
0389   0074             int_7_uart0:
0390   0074 D7            push a
0391   0075 DA            push d
0392   0076 E1            pushf
0393   0077 1D 80 FF      mov al, [_uart0_data]       ; get character
0394   007A B9 03         cmp al, $03                 ; ctrl-c
0395   007C C6 A0 00      je ctrlc
0396   007F B9 1A         cmp al, $1a                 ; ctrl-z
0397   0081 C6 A6 00      je ctrlz
0398   0084               ;mov [[d]], al              ; TODO: implement this double indirection instruction
0399   0084 3B 5A 19      mov d, fifo_in
0400   0087 FD 2A         mov d, [d]
0401   0089 3E            mov [d], al                 ; add to fifo
0402   008A 13            mov a, d
0403   008B 77            inc a
0404   008C AF 5B 31      cmp a, fifo + _fifo_size     ; check if pointer reached the end of the fifo
0405   008F C7 95 00      jne int_7_continue
0406   0092 10 5B 21      mov a, fifo  
0407   0095             int_7_continue:  
0408   0095 42 5A 19      mov [fifo_in], a            ; update fifo pointer
0409   0098 1A            mov al, ah
0410   0099 3D B0 FF      mov [_til311_display], al
0411   009C EE            popf
0412   009D E7            pop d
0413   009E E4            pop a  
0414   009F 06            sysret
0415   00A0             
0416   00A0             ctrlc:
0417   00A0 51 05 00      add sp, 5
0418   00A3 0A 97 10      jmp syscall_terminate_proc
0419   00A6             ctrlz:
0420   00A6 51 05 00      add sp, 5
0421   00A9 0A DA 10      jmp syscall_pause_proc      ; pause current process and go back to the shell
0422   00AC             
0423   00AC             sys_mkfs:
0424   00AC 06            sysret
0425   00AD             
0426   00AD             ; ------------------------------------------------------------------------------------------------------------------;
0427   00AD             ; floppy drive syscalls
0428   00AD             ; ------------------------------------------------------------------------------------------------------------------;
0429   00AD             ; data for formatting a floppy drive in single density mode (128 bytes per sector):
0430   00AD             ; fdc_40_ff:
0431   00AD             ;   .fill 40,  $ff    ; or 00                                                                                
0432   00AD             ; fdc_128_format_inner:
0433   00AD             ;   .fill 6,   $00    ;                                                                            <--|        
0434   00AD             ;   .fill 1,   $fe    ; id address mark                                                               |        
0435   00AD             ;   .fill 1,   $00    ; track number  0 thru 39                                                       |                    
0436   00AD             ;   .fill 1,   $00    ; side number 00 or 01                                                          |                
0437   00AD             ;   .fill 1,   $01    ; sector number  0x01 through 0x10                                              |                              
0438   00AD             ;   .fill 1,   $00    ; sector length                                                                 |                        
0439   00AD             ;   .fill 1,   $f7    ; 2 crc's written                                                               | write 16 times                 
0440   00AD             ;   .fill 11,  $ff    ; or 00                                                                         |                      
0441   00AD             ;   .fill 6,   $00    ;                                                                               |                        
0442   00AD             ;   .fill 1,   $fb    ; data address mark                                                             |                                  
0443   00AD             ;   .fill 128, $e5    ; data (ibm uses e5)                                                            |                                      
0444   00AD             ;   .fill 1,   $f7    ; 2 crc's written                                                               |                                                        
0445   00AD             ;   .fill 10,  $ff    ; or 00                                                                      <--|                                                  
0446   00AD             ; fdc_128_format_end:
0447   00AD             ;   .fill 369, $ff    ; or 00. continue writing until wd1770 interrupts out. approx 369 bytes.                                                                
