1689   0896 58 20 00      add d, 32
1690   0899 14 56 19      mov a, [index]
1691   089C 77            inc a
1692   089D 42 56 19      mov [index], a
1693   08A0 AF 10 00      cmp a, fst_files_per_dir
1694   08A3 C7 8A 08      jne fs_chmod_l1
1695   08A6 EA            pop bl
1696   08A7 0A C3 08      jmp fs_chmod_not_found
1697   08AA             fs_chmod_found_entry:  
1698   08AA FD 79         mov g, b                    ; save lba
1699   08AC EA            pop bl                      ; retrieve saved permission value
1700   08AD 1F 18 00      mov al, [d + 24]            ; read file permissions
1701   08B0 87 F8         and al, %11111000           ; remove all permissions, keep other flags
1702   08B2 8C            or al, bl                   ; set new permissions
1703   08B3 3F 18 00      mov [d + 24], al            ; write new permissions
1704   08B6 38 00 00      mov c, 0
1705   08B9 3B 5B 33      mov d, transient_area
1706   08BC 22 01         mov ah, $01                 ; disk write 1 sect
1707   08BE FD 27         mov b, g                    ; retrieve lba
1708   08C0 07 E4 06      call ide_write_sect         ; write sector
