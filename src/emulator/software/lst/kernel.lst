0044   0000             _uart1_dlab_1     .equ $ff89         ; divisor latch high byte
0045   0000             _uart1_ier        .equ $ff89         ; interrupt enable register
0046   0000             _uart1_fcr        .equ $ff8A         ; fifo control register
0047   0000             _uart1_lcr        .equ $ff8B         ; line control register
0048   0000             _uart1_lsr        .equ $ff8D         ; line status register
0049   0000             
0050   0000             _ide_base         .equ $ffd0         ; ide base
0051   0000             _ide_r0           .equ _ide_base + 0 ; data port
0052   0000             _ide_r1           .equ _ide_base + 1 ; read: error code, write: feature
0053   0000             _ide_r2           .equ _ide_base + 2 ; number of sectors to transfer
0054   0000             _ide_r3           .equ _ide_base + 3 ; sector address lba 0 [0:7]
0055   0000             _ide_r4           .equ _ide_base + 4 ; sector address lba 1 [8:15]
0056   0000             _ide_r5           .equ _ide_base + 5 ; sector address lba 2 [16:23]
0057   0000             _ide_r6           .equ _ide_base + 6 ; sector address lba 3 [24:27 (lsb)]
0058   0000             _ide_r7           .equ _ide_base + 7 ; read: status, write: command       
