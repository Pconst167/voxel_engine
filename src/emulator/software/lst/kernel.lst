0007   0000             ; 0000 ... 7fff - rom space
0008   0000             ; 8000 ... f7ff - ram space
0009   0000             ; f7ff          - stack root
0010   0000             
0011   0000             ; i/o map
0012   0000             ; ------------------------------------------------------------------------------------------------------------------;
0013   0000             ; ff80 - uart 0 (16550)
0014   0000             ; ff88 - uart 1 (16550)
0015   0000             ; ff90 - game port
0016   0000             ; ffa0 - rtc    (m48t02)
0017   0000             ; ffb0 - pio 0  (8255)
0018   0000             ; ffc0 - fdd    (5.25" floppy drive block)
0019   0000             ;   - ffc0      output port (377 flip-flop)                  
0020   0000             ;   - ffc1      input port  (244 buffer)                     
0021   0000             ;   - ffc8      wd1770 status/command    
0022   0000             ;   - ffc9      wd1770 track register
0023   0000             ;   - ffca      wd1770 sector register
0024   0000             ;   - ffcb      wd1770 data register
0025   0000             ;      
0026   0000             ; ffd0 - ide    (compact flash / pata)
0027   0000             ; ffe0 - timer  (8253)
0028   0000             ; fff0 - bios configuration nv-ram store area
