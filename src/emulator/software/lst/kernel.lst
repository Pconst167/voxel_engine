0591   01AD FD 4D 5B 33   mov si, transient_area
0592   01B1 F2 C8 FF F2   mov byte [_fdc_stat_cmd], %11110010 ; write track command
0593   01B5 07 5C 03      call fdc_wait_64us
0594   01B8             fdc_formatdisk_drq_512:
