0894   035C             
0895   035C             ; fetch is 2 cycles long when 'display_reg_load' is false.
0896   035C             ; 64us amounts to 160 cycles of the 2.5mhz clock
0897   035C             ; call u16 is 14 cycles long
0898   035C             ; 160 - 5 - 14 = 
0899   035C             fdc_wait_64us:
0900   035C 3A 0D         mov cl, 13                       ; 5 cycles
0901   035E             fdc_wait_64_loop:
0902   035E 81            dec cl                           ; 3 cycles
0903   035F C7 5E 03      jnz fdc_wait_64_loop             ; 8 cycles
0904   0362 09            ret
