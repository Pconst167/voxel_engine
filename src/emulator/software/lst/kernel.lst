1497   0753             ; bit7 is the divisor latch access bit (dlab). it must be set high (logic 1) to access the divisor latches
1498   0753             ; of the baud generator during a read or write operation. it must be set low (logic 0) to access the receiver
1499   0753             ; buffer, the transmitter holding register, or the interrupt enable register.
1500   0753             syscall_io_uart_setup:
1501   0753 1D 4A 19      mov al, [sys_uart0_lcr]
1502   0756 8B 80         or al, $80                ; set dlab access bit
1503   0758 3D 83 FF      mov [_uart0_lcr], al      ; 8 data, 2 stop, no parity by default
1504   075B 1D 4D 19      mov al, [sys_uart0_div0]
1505   075E 3D 80 FF      mov [_uart0_dlab_0], al   ; divisor latch byte 0
1506   0761 1D 4E 19      mov al, [sys_uart0_div1]
1507   0764 3D 81 FF      mov [_uart0_dlab_1], al   ; divisor latch byte 1      
1508   0767 1D 4A 19      mov al, [sys_uart0_lcr]
