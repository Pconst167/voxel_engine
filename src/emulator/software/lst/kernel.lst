0576   018E 26 08 00      mov b, 8
0577   0191 07 63 03      call wait_xs
0578   0194 F2 C8 FF 53   mov byte [_fdc_stat_cmd], %01010011  ; step in
0579   0198 E5            pop b
0580   0199 6C 01         add bl, 1
0581   019B C1 28         cmp bl, 40
0582   019D C7 61 01      jne fdc_formatdisk128_l0
