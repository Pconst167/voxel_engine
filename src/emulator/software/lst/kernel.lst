0075   0000             _timer_c_1        .equ $ffe1         ; timer counter 1
0076   0000             _timer_c_2        .equ $ffe2         ; timer counter 2
0077   0000             _timer_ctrl       .equ $ffe3         ; timer control register
0078   0000             
0079   0000             _gameport         .equ $ff90         ; game port registers
0080   0000             
0081   0000             _stack_begin      .equ $f7ff         ; beginning of stack
0082   0000             _fifo_size        .equ 4096
0083   0000             
0084   0000             _mbr                     .equ 960
0085   0000             _superblock              .equ 1024
0086   0000             _block_group_descriptor  .equ 2048
0087   0000             
0088   0000             text_org          .equ $400          ; code origin address for all user processes
0089   0000             
0090   0000             
0091   0000             ;  ------------------------------------------------------------------------------------------------------------------;
0092   0000             ;  DISK LAYOUT:
0093   0000             ;  Metadata               | Size (bytes)      | Blocks (2048 bytes)              |Start Block |  Comment
0094   0000             ;  ---------------------- | ----------------- | -------------------------------- |------------|-----------------------------------
0095   0000             ;  Bootloader/MBR         | 512 bytes         | 0.25 (1 sector)                  |  0         |
0096   0000             ;  Superblock             | 1024 bytes        | 1 block (2048 bytes, must align) |  0         |
0097   0000             ;                         |                   | 1 block (2048 bytes)             |  1         | reserved
0098   0000             ;  Block Bitmap           | 8,192 bytes       | 4 blocks                         |  2         | 4*2048*8 = 4*16384 = 65536 raw data blocks.  65536*2048 bytes = 134217728 bytes of disk space = 128MB
0099   0000             ;  Inode Bitmap           | 2,048 bytes       | 1 block                          |  6         | 2048*8=16384. total of 16384 bits, meaning 16384 inodes, which is 1 inode per 8KB of disk space
0100   0000             ;  Inode Table            | 2,097,152 bytes   | 1024 blocks                      |  7         | 128bytes per inode entry. 2097152 / 128 = 16384 inodes
0101   0000             ;  Data Blocks            | 134,217,728 bytes | 65528 blocks                     | 1031       | 65528 blocks = 134,201,344 bytes
0102   0000             ;  
0103   0000             ;  first 512 bytes: bootloader from 0 to 445, MBR partition table from 446 to 511 (64 bytes)
0104   0000             ;  up to 4 partitions, each 16 bytes long
0105   0000             ;  MBR:
0106   0000             ;  Byte | Description
0107   0000             ;  -----|----------------------------
0108   0000             ;  0    | Boot flag (0x80 active, 0x00 inactive)
0109   0000             ;  1-3  | Start CHS (head, sector, cylinder)
0110   0000             ;  4    | Partition type (filesystem ID)
0111   0000             ;    0x83 = Linux native (ext2/3/4)
0112   0000             ;    0x07 = NTFS/exFAT
0113   0000             ;    0x0B = FAT32 CHS
0114   0000             ;    0x0C = FAT32 LBA
0115   0000             ;    0x05 = Extended partition
0116   0000             ;    0x86 = Sol-1 partition
0117   0000             ;  5-7  | End CHS
0118   0000             ;  8-11 | Start LBA (little endian)
0119   0000             ;  12-15| Size in sectors (little endian)
0120   0000             ;  
0121   0000             ;  
0122   0000             ;  the superblock describers the filesystem as a whole such as inode count, free inode count, location of the raw data bitmap, inode table, etc.  
0123   0000             ;  SUPERBLOCK:
0124   0000             ;  | Field               | Description                               | Typical Size (bytes) | Notes                           |
0125   0000             ;  | ------------------- | ----------------------------------------- | -------------------- | ------------------------------- |
0126   0000             ;  | inodes_count        | Total number of inodes in the filesystem  | 2                    | 16-bit unsigned int             |
0127   0000             ;  | blocks_count        | Total number of data blocks               | 2                    | 16-bit unsigned int             |
0128   0000             ;  | free_inodes_count   | Number of free inodes                     | 2                    | 16-bit unsigned int             |
0129   0000             ;  | free_blocks_count   | Number of free blocks                     | 2                    | 16-bit unsigned int             |
0130   0000             ;  | block_bitmap        | Block ID of the **block bitmap**          | 2                    | 16-bit unsigned int
0131   0000             ;  | inode_bitmap        | Block ID of the **inode bitmap**          | 2                    | 16-bit unsigned int
0132   0000             ;  | inode_table         | Starting block of **inode table**         | 2                    | 16-bit unsigned int
0133   0000             ;  | first_data_block    | Block number of the first data block      | 2                    | 16-bit unsigned int             |
0134   0000             ;  | used_dirs_count     | Number of inodes allocated to directories | 2
0135   0000             ;  | log_block_size      | Block size = 1024 << `s_log_block_size    | 2                    | 16-bit unsigned int             |
0136   0000             ;  | mtime               | Last mount time                           | 4                    | 32-bit unsigned int (Unix time) |
0137   0000             ;  | wtime               | Last write time                           | 4                    | 32-bit unsigned int (Unix time) |
0138   0000             ;  | uuid                | Unique ID of the filesystem               | 16                   | 128-bit UUID                    |
0139   0000             ;  | volume_name         | Label of the filesystem                   | 16                   | Usually ASCII, padded           |
0140   0000             ;  | feature_flags       | Compatibility flags                       | 4                    | 32-bit unsigned int             |
0141   0000             ;  
0142   0000             ;  inode for root dir is #2, #0 and #1 not used
0143   0000             ;  raw data block #0 is not used. because 0 as a block ID means not used
0144   0000             ;  block size: 2048
0145   0000             ;  inode-table format:
0146   0000             ;  | Field         | Size (bytes) | Description                                                                                  |
0147   0000             ;  | ------------- | ------------ | -------------------------------------------------------------------------------------------- |
0148   0000             ;  | `mode`        | 2            | File type and permissions                                                                    |
0149   0000             ;  | `uid`         | 2            | Owner user ID                                                                                |
0150   0000             ;  | `size`        | 4            | Size of the file in bytes                                                                    |
0151   0000             ;  | `atime`       | 4            | Last access time (timestamp)                                                                 |
0152   0000             ;  | `ctime`       | 4            | Creation time (timestamp)                                                                    |
0153   0000             ;  | `mtime`       | 4            | Last modification time (timestamp)                                                           |
0154   0000             ;  | `dtime`       | 4            | Deletion time (timestamp)                                                                    |
0155   0000             ;  | `gid`         | 2            | Group ID                                                                                     |
0156   0000             ;  | `links_count` | 2            | Number of hard links                                                                         |
0157   0000             ;  | `blocks`      | 2            | Number of 2048-byte blocks allocated                                                         |
0158   0000             ;  | `flags`       | 4            | File flags                                                                                   |
0159   0000             ;  | `block`       | 47 * 2 = 94  | Pointers to data blocks (47 direct only) 
0160   0000             ;
0161   0000             ;
0162   0000             ;  DIRECTORY ENTRY
0163   0000             ;  this is the structure for file entries inside a directory.
0164   0000             ;  2048 / 64 = 32 entries
0165   0000             ;
0166   0000             ;  each entry is 64 bytes wide
0167   0000             ;  uint16_t inode;      // Inode number (0 if entry is unused)
0168   0000             ;  char     name[62];   // File name (null terminated)
0169   0000             
0170   0000             
0171   0000             ; file entry attributes
0172   0000             ; filename (24)
0173   0000             ; attributes (1)       :|0|0|file_type(3bits)|x|w|r|
0174   0000             ; lba (2)              : location of raw data for file entry, or dirid for directory entry
0175   0000             ; size (2)             : filesize
0176   0000             ; day (1)           
0177   0000             ; month (1)
0178   0000             ; year (1)
0179   0000             ; packet size = 32 bytes  : total packet size in bytes
0180   0000             
0181   0000             fst_entry_size      .equ 32  ; bytes
0182   0000             fst_files_per_sect  .equ (512 / fst_entry_size)
0183   0000             fst_files_per_dir   .equ (512 / fst_entry_size)
0184   0000             fst_nbr_directories .equ 64
0185   0000                                 ; 1 sector for header, the rest is for the list of files/dirs
0186   0000             fst_sectors_per_dir .equ (1 + (fst_entry_size * fst_files_per_dir / 512))    
0187   0000             fst_total_sectors   .equ (fst_sectors_per_dir * fst_nbr_directories)
0188   0000             fst_lba_start       .equ 32
0189   0000             fst_lba_end         .equ (fst_lba_start + fst_total_sectors - 1)
0190   0000             
0191   0000             fs_nbr_files        .equ (fst_nbr_directories * fst_files_per_dir)
0192   0000             fs_sectors_per_file .equ 32 ; the first sector is always a header with a null parameter (first byte)
0193   0000                                         ; so that we know which blocks are free or taken
0194   0000             fs_file_size        .equ (fs_sectors_per_file * 512)                  
0195   0000             fs_total_sectors    .equ (fs_nbr_files * fs_sectors_per_file)
0196   0000             fs_lba_start        .equ (fst_lba_end + 1)
0197   0000             fs_lba_end          .equ (fs_lba_start + fs_total_sectors - 1)
0198   0000             
0199   0000             root_id:            .equ fst_lba_start
