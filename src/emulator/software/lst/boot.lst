0003   8004             .org boot_origin
0004   8004             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0005   8004             ; system constants / equations
0006   8004             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0007   8004             _uart0_data      .equ $ff80            ; data
0008   8004             _uart0_dlab_0    .equ $ff80            ; divisor latch low byte
0009   8004             _uart0_dlab_1    .equ $ff81            ; divisor latch high byte
0010   8004             _uart0_ier       .equ $ff81            ; interrupt enable register
0011   8004             _uart0_fcr       .equ $ff82            ; fifo control register
0012   8004             _uart0_lcr       .equ $ff83            ; line control register
0013   8004             _uart0_lsr       .equ $ff85            ; line status register
0014   8004             
0015   8004             _ide_base        .equ $ffd0            ; ide base
0016   8004             _ide_r0          .equ _ide_base + 0    ; data port
0017   8004             _ide_r1          .equ _ide_base + 1    ; read: error code, write: feature
0018   8004             _ide_r2          .equ _ide_base + 2    ; number of sectors to transfer
0019   8004             _ide_r3          .equ _ide_base + 3    ; sector address lba 0 [0:7]
0020   8004             _ide_r4          .equ _ide_base + 4    ; sector address lba 1 [8:15]
0021   8004             _ide_r5          .equ _ide_base + 5    ; sector address lba 2 [16:23]
0022   8004             _ide_r6          .equ _ide_base + 6    ; sector address lba 3 [24:27 (lsb)]
0023   8004             _ide_r7          .equ _ide_base + 7    ; read: status, write: command
0024   8004             
0025   8004             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0026   8004             ; setting up kernel process.
0027   8004             ; 32 pages of 2kb = 64kb
0028   8004             ; bl = ptb
0029   8004             ; bh = page number (5bits)
0030   8004             ; a = physical address
0031   8004             ; for kernel, a goes from 0 to 31, but for the last page, bit '11' must be 1 for device space
0032   8004             ; bl = 0
0033   8004             ; bh(ms 5 bits) = 0 to 31
0034   8004             ; a = 0000_1000_000_00000
0035   8004             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0036   8004             setup_kernel_mem:
0037   8004 3B B3 80      mov d, s_boot1
0038   8007 07 85 80      call _puts
0039   800A               
0040   800A 3B CA 80      mov d, s_kernel_setup
0041   800D 07 85 80      call _puts
0042   8010             ; map pages 0 to 30 to normal kernel ram memory.
0043   8010 2E 00         mov bl, 0             ; set ptb = 0 for kernel
0044   8012 A7 00         mov bh, 0             ; start at page 0
0045   8014 10 00 00      mov a, 0              ; set mem/io bit to memory.  this means physical address starting at 0, but in memory space as opposed to device space.
0046   8017             map_kernel_mem_l1:
0047   8017 02            pagemap               ; write page table entry
0048   8018 55 00 08      add b, $0800          ; increase page number (msb 5 bits of bh only)
0049   801B 7A            inc al                ; increase both 
0050   801C B9 1F         cmp al, 31            ; check to see if we reached the end of memory for kernel
0051   801E C7 17 80      jne map_kernel_mem_l1
0052   8021               
0053   8021             ; here we map the last page of kernel memory, to device space, or the last 2kb of bios memory so that the kernel has access to io devices.
0054   8021 89 00 08      or a, $0800           ; set mem/io bit to device, for physical address
0055   8024 02            pagemap               ; write page table entry
0056   8025               
0057   8025 19 00         mov al, 0
0058   8027 01            setptb                ; set process number to 0 (strictly not needed since we are in supervisor mode)
0059   8028                                     ; which forces the page number to 0
0060   8028 3B 1F 81      mov d, s_boot
0061   802B 07 85 80      call _puts
0062   802E             
0063   802E             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  
0064   802E             ; we read sector 0, in order to obtain the lba location of the kernel in the disk
0065   802E             ; this kernel lba is actually the second sector because the first sector is the usual file block
0066   802E             ; header and has no useful kernel data.
0067   802E 38 00 00      mov c, 0
0068   8031 26 00 00      mov b, 0                   ; start at disk sector 1
0069   8034 3B 04 84      mov d, ide_buffer          ; we read into the bios ide buffer
0070   8037 10 02 01      mov a, $0102               ; disk read, 1 sector
0071   803A 05 03         syscall bios_ide           ; read sector
0072   803C 14 02 86      mov a, [ide_buffer + 510]  ; here we now have the kernel's lba location in disk
0073   803F             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0074   803F 27            mov b, a                   ; transfer the sector number into register b for use below
0075   8040 D7            push a                     ; also, save the lba value for later
0076   8041             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  
0077   8041             ; having obtained the first kernel sector address,
0078   8041             ; we read the first kernel sector, in order to obtain the reset vector at location $10
0079   8041 38 00 00      mov c, 0
0080   8044 3B 04 84      mov d, ide_buffer           ; we read into the bios ide buffer
0081   8047 10 02 01      mov a, $0102                ; disk read, 1 sector
0082   804A 05 03         syscall bios_ide            ; read sector
0083   804C 14 14 84      mov a, [ide_buffer + $10]   ; here we now have the kernel reset vector
0084   804F FD 78         mov g, a                    ; save reset vector in g  
0085   8051             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0086   8051               
0087   8051             ; read operating system into kernel memory
0088   8051 E5            pop b                       ; pop the kernel's starting lba address that we pushed into the stack earlier
0089   8052                                           ; as we now need to load the kernel from disk, from that lba address
0090   8052 38 00 00      mov c, 0
0091   8055 3B 04 84      mov d, ide_buffer           ; we read into the bios ide buffer
0092   8058 10 02 1F      mov a, $1F02                ; disk read, 31 sectors. 31 sectors because the first sector of the kernel is just a file block header
0093   805B                                           ; used to tell whether that block is taken. so the file really has 31 sectors 
0094   805B                                           ; in this current file system (which is a hack and is temporary)
0095   805B 05 03         syscall bios_ide            ; read sector
0096   805D 38 00 3E      mov c, 512 * 31             ; 31 sectors to copy
0097   8060 FD 4D 04 84   mov si, ide_buffer
0098   8064 FD 4F 00 00   mov di, 0                   ; start at kernel memory address 0
0099   8068 FD 08         supcpy                      ; now copy data from bios mem to kernel mem
0100   806A             
0101   806A             ; interrupt masks  
0102   806A 19 FF         mov al, $ff
0103   806C FD 0F         stomsk                      ; store masks
0104   806E 3B F6 80      mov d, s_masks
0105   8071 07 85 80      call _puts
0106   8074               
0107   8074 3B 39 81      mov d, s_bios2
0108   8077 07 85 80      call _puts
0109   807A             
0110   807A             ; now we start the kernel.
0111   807A FD 12         mov a, g                    ; retrieve kernel reset vector
0112   807C             
0113   807C FD D7 FF FF   push word $ffff             ; stack. dummy value since the real value is set in the kernel code
0114   8080 FD DB 08      push byte %00001000         ; mode =supervisor, paging=on
0115   8083 D7            push a                      ; pc
0116   8084 06            sysret
0117   8085             
0118   8085               
0119   8085             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0120   8085             ; print null terminated string
0121   8085             ; pointer in d
0122   8085             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0123   8085             _puts:
0124   8085 D7            push a
0125   8086 DA            push d
0126   8087 E1            pushf
0127   8088             _puts_l1:
0128   8088 1E            mov al, [d]
0129   8089 B9 00         cmp al, 0
0130   808B C6 9E 80      jz _puts_end
0131   808E             _puts_l2:
0132   808E 1D 85 FF      mov al, [_uart0_lsr]      ; read line status register
0133   8091 93 20         test al, $20              ; isolate transmitter empty
0134   8093 C6 8E 80      jz _puts_l2    
0135   8096 1E            mov al, [d]
0136   8097 3D 80 FF      mov [_uart0_data], al     ; write char to transmitter holding register
0137   809A 79            inc d  
0138   809B 0A 88 80      jmp _puts_l1
0139   809E             _puts_end:
0140   809E EE            popf
0141   809F E7            pop d
0142   80A0 E4            pop a
0143   80A1 09            ret
0144   80A2               
0145   80A2             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0146   80A2             ; _putchar
0147   80A2             ; char in ah
0148   80A2             ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
0149   80A2             _putchar:
0150   80A2 D7            push a
0151   80A3 E1            pushf
0152   80A4             _putchar_l1:
0153   80A4 1D 85 FF      mov al, [_uart0_lsr]    ; read line status register
0154   80A7 93 20         test al, 20h            ; isolate transmitter empty
0155   80A9 C6 A4 80      jz _putchar_l1    
0156   80AC 1A            mov al, ah
0157   80AD 3D 80 FF      mov [_uart0_data], al   ; write char to transmitter holding register
0158   80B0 EE            popf
0159   80B1 E4            pop a
0160   80B2 09            ret
